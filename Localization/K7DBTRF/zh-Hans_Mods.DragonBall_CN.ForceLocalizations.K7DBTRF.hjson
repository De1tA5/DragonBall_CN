				}

				2: {
					// OldString: You unlocked a form unknown to all, select the form and transform as usual
					NewString: 你解锁了一个无人知晓的形态，选择它并像往常一样变身
				}
			}
		}

		SSJ8Unlock: {
			OnConsumeItem: {
				1: {
					// OldString: You successfully add 2 forms together! The new power of LSSJ8 covers you!
