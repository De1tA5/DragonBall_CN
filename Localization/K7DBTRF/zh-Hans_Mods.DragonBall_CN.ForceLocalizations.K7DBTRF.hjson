					'''
			}

			2: {
				// OldString: DBZMODPORT
				// NewString: DBZMODPORT
			}

			3: {
				// OldString: You accepted evil ki, it covers your body, a new form is born!
				NewString: 你接受了邪恶的气，它覆盖你全身，全新的形态就此诞生！
			}

			4: {
				// OldString: You stack together LSSJ3 and LSSJ5, the combination of 2 forms creates abysmal power!
				NewString: 你将传说超级赛亚人3和传说超级赛亚人5叠加在一起，2种形态的结合产生了深渊般的力量！
			}

			5: {
				// OldString: You achieve the most dangerous power a saiyan can have, beware of it
				NewString: 你已获得赛亚人所能拥有的最危险力量，务必小心
			}
		}

