Changes: {
	Elder: {
		SetNPCNameList: {
			1: {
				// OldString: Kai
				// NewString: Kai
			}
		}

		SetChatButtons: {
			1: {
				// OldString: Potential Unleash
				NewString: 潜能解放
			}
		}

		OnChatButtonClicked: {
			1: {
				// OldString: GohanForms
				// NewString: GohanForms
			}

			2: {
				// OldString: You have ritual buff, after 4 minutes your potential will be unleashed
				NewString: 你已获得潜能解放仪式，4分钟后你的潜能就将得到解放
			}

			3: {
				// OldString: You have already reached your maximum
				NewString: 你已经达到你的极限了
			}

			4: {
				// OldString: Legendary
				// NewString: Legendary
			}

			5: {
				// OldString: Gifted warriors like you dont need such a form
				NewString: 像你这样的有天赋的战士，不需要这种形态
			}
		}

		GetChat: {
			1: {
				// OldString: Don't ask me how I ended up in this sword
				NewString: 别问我为什么会被困在这把剑中
			}

			2: {
				// OldString: Don't you have any magazines with you?
				NewString: 你身上没有带任何一本杂志吗？
			}

			3: {
				// OldString: Do you want me to unleash your potential?
				NewString: 你想让我帮你解放你的潜能吗？
			}
		}
	}
}

