Mods: {
	DBZGoatLib: {
		Configs: {
			Headers: {
				Bar: 气槽设置
				Menu: 变身菜单设置
			}

			KiBarX: {
				Label: 气槽X轴坐标
				Tooltip: 气槽在屏幕上的水平位置
			}

			KiBarY: {
				Label: 气槽Y轴坐标
				Tooltip: 气槽在屏幕上的垂直位置
			}

			ShowKi: {
				Label: 显示气数值
