			6: {
				// OldString: You have gone once again, one step beyond.
				NewString: 你再次迈出了超越极限的一步
			}

			7: {
				// OldString: Use your full power to blow them away.
				NewString: 释放你全部的力量，将他们彻底击溃
			}

			8: {
				// OldString: The primal rage awakes inside you!
				NewString: 原始的怒火在你体内觉醒！
			}

			9: {
				// OldString: Your limits are broken once again!
				NewString: 你再一次突破自身的桎梏
			}

			10: {
				// OldString: Limit Break X Survior is such a banger, honestly kinda tempted to make the aura sound the song.
				NewString:
					'''
					《Limit Break × Survivor》真是夯爆了，说实话我有点想把变身光环音效改成这首歌
					[C/959595:译者补充：《Limit Break × Survivor》为《龙珠超》第2首OP曲]
					'''
			}

			11: {
				// OldString: Your power quakes across the land!
				NewString: 你的力量在大地间回荡令其颤抖！
			}

			12: {
				// OldString: Young Jijii would be proud! Now, show them what you're made of!!
				NewString:
					'''
					Young Jijii 一定会感到骄傲！现在，展现你真正的实力吧！！
					[C/959595:译者补充：Young Jijii为龙珠同人作品《新龙珠AF》的作者，其中超级赛亚人5出自该作品]
					'''
			}

