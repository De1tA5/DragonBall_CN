NPCs: {
	ElderMoori: {
		SetNPCNameList: {
			1: {
				// OldString: Grand Elder Moori
				NewString: 大长老穆利
			}
		}

		GetChat: {
			1: {
				// OldString: I wish I could've golfed back on Namek.
				NewString: 我真希望我当初能在那美克星打高尔夫。
			}

			2: {
				// OldString: Do you know about the Namekian dragon balls?
				NewString: 你知道那美克星龙珠吗？
			}

			3: {
				// OldString: I guess this place is ok, but I prefer the green sky of Namek.
				NewString: 我觉得这地方还行，但我更喜欢那美克星的绿色天空。
			}

			4: {
				// OldString: This... Hallow.  It makes me feel like I'm back on Namek.
				NewString: 这片……神圣之地。让我感觉像回到了那美克星。
			}

			5: {
				// OldString: I've got some cool stuff to show you!
				NewString: 我有一些很酷的东西要给你看！
			}

			6: {
				// OldString: I never thought I'd see the mythical Super Saiyan.
				NewString: 我从没想过能见到传说中的超级赛亚人。
			}
		}

		SetChatButtons: {
			1: {
				// OldString: Shop
				NewString: 商店
			}
		}

		OnChatButtonClicked: {
			1: {
