			}
		}

		AddShops: {
			1: {
				// OldString: Shop
				// NewString: Shop
			}
		}

		SetBestiary: {
			1: {
				// OldString: The Elder of one of the Namekian villages.  He happens to enjoy golfing, as well as collecting Dragon Balls.
				NewString: 那美克星某个村庄的长老。他碰巧喜欢打高尔夫，也喜欢收集龙珠。
			}
		}
	}

