NPCs: {
	ElderMoori: {
		DisplayName: 大长老穆利

		TownNPCMood: {
			Content: I guess this isn't so bad.  The longer I'm here, the less I miss Namek.
			NoHome: I don't seem to belong here, and I can't return to Namek!
			FarFromHome: I hope my NEW home doesn't blow up, too!
			LoveSpace: This is great!  I haven't felt like this since being on Namek!
			DislikeCrowded: There was much more room at my house on Namek...
			HateCrowded: If only all of these people were on Namek when it blew up!
			LoveBiome: This reminds me of Namek!
			LikeBiome: Not quite Namek, but it'll do!
			DislikeBiome: I feel far too alienated here.  Ironic...
			LoveNPC: What are these emotions I feel fore {NPCName}?}
			LikeNPC: That {NPCName}; what a friendly individual!
			DislikeNPC: "{NPCName} is really getting under my skin."
			HateNPC: "{NPCName} is a real jerk!"
			LikeNPC_Princess: "{NPCName} is royalty?"
			Princess_LovesNPC: "{NPCName} is such a lovely individual!"
		}

		Census.SpawnCondition: Conditions unknown
	}

	GreenWyvernBody.DisplayName: Green Wyvern Body
	GreenWyvernBody2.DisplayName: Green Wyvern Body2
	GreenWyvernBody3.DisplayName: Green Wyvern Body3
	GreenWyvernHead.DisplayName: Green Wyvern Head
	GreenWyvernLegs.DisplayName: Green Wyvern Legs
	GreenWyvernTail.DisplayName: Green Wyvern Tail

	Zeno: {
		DisplayName: 全王
		TownNPCMood: {
			Content: I like it here!
			NoHome: Having a home would be fun.
			FarFromHome: I wish I was having fun at home.
			LoveSpace: This place is super fun!
			DislikeCrowded: These people are not very fun.
			HateCrowded: I will erase everybody here.
			LoveBiome: This environment is so fun!
			LikeBiome: This area is fun.
			DislikeBiome: This place is not fun.
			LoveNPC: "{NPCName} is such a fun friend!"
			LikeNPC: "{NPCName} is fun!"
			DislikeNPC: "{NPCName} isn't very fun."
			HateNPC: I will erase {NPCName}
			LikeNPC_Princess: "{NPCName} is a good friend."
			Princess_LovesNPC: "{NPCName} is royalty?  So fun!"
		}

		Census.SpawnCondition: Conditions unknown
	}
}

