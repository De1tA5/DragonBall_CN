Items: {
	AndroidEngine: {
		DisplayName: Android Engine
		Tooltip:
			'''
			The artificial heart grants you incredible powers
			-1% Decreased Ki damage 
			Near near infinite Ki 
			Attacking too much overheats and deals damage to you
			'''
	}

	AviationBoots: {
		DisplayName: Aviation Boots
		Tooltip:
			'''
			4% Increased Ki damage
			You're able to fly for a short while
			Flying creates a damaging trail
			'''
	}

	DiamondStorm: {
		DisplayName: Diamond Storm
		Tooltip:
			'''
			+20 max HP
			12% increased ki damage, 14% increased ki knockback.
			+250 Max Ki.
			Getting hit restores a small amount of Ki and shoots down many arrows, increased with damage taken.
			The arrows give you a damage increasing buff, and return to you upon missing a target.
			'''
	}

	ElysianCrystal: {
		DisplayName: Elysian Crystal
		Tooltip:
			'''
			Blessed by the Profaned Flame
