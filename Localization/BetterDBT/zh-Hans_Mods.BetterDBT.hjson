	}

	PolterghastSoul: {
		DisplayName: 噬魂幽花之魂
		Tooltip: "[C/959595:译者补充：请将《龙珠汉化全集》配置选项中修复打开，才能补充其配方]"
	}

	WitchSoul: {
		DisplayName: 至尊女巫之魂
		Tooltip: "[C/959595:译者补充：请将《龙珠汉化全集》配置选项中修复打开，才能补充其配方]"
	}

	GokuSenzuBean: {
		DisplayName: 悟空的仙豆
		Tooltip: "[C/959595:译者补充：击败硫海遗爵、亵渎天神和犽戎掉落，有且只掉落一次]"
	}

	DragonGauntlet: {
		DisplayName: 龙拳
		Tooltip: 右键攻击：龙拳，召唤一条巨龙追击敌怪
	}

	StatEditorItem: {
		DisplayName: 自定义气武器
		Tooltip:
			'''
			持有武器右键点击打开UI
			你可以使用点数提升武器属性
			你可以通过击败Boss和完成事件获得点数
			左键点击图标增加点数，右键点击图标移除点数
			你也可以按住Shift再任意点击，一次移除/增加10点
			要离开UI，点击右上角的离开图标
			要应用更改，点击离开图标的下方图标
			将此物品保持在快捷栏中选中，即可保持UI打开
			[C/959595:译者补充：该武器十分复杂，左上属性从左到右分别为：攻击、攻击速度、暴击率、弹幕速度]
			[C/959595:左下从左到右分别为：武器弹幕AI、武器弹幕额外属性]
			[C/959595:武器弹幕AI：]
			[C/959595:普通气弹]
			[C/959595:追踪 （击败世纪之花）]
			[C/959595:多发 （击败史莱姆皇后）]
			[C/959595:元气斩 （击败骷髅王）]
			[C/959595:环绕 （击败克苏鲁之眼）]
			[C/959595:反折 （击败蜂王）]
			[C/959595:二段追踪 （击败任意机械Boss）]
			[C/959595:武器弹幕额外属性：]
			[C/959595:无]
			[C/959595:生命窃取 （击败任意机械Boss）]
			[C/959595:爆炸 （击败史莱姆皇后）]
			[C/959595:防御增益 （击败独眼巨鹿）]
			[C/959595:反弹 （击败世界吞噬者或克苏鲁之脑）]
			[C/959595:穿墙 （击败骷髅王）]
			'''
	}

	LegendaryFist: {
		DisplayName: 传说之拳
		Tooltip: 右键攻击：传说粉碎，抓住附近的一名敌怪并对其造成5次伤害
