Items: {
	SoulBondingAmulet: {
		DisplayName: 伪融合项链
		Tooltip:
			'''
			2名玩家能在短时间内融合
			查看融合界面以操作
			[C/959595:译者补充：击败所有机械Boss后，会在一定时间后从天而降]
			'''
	}

	MeteorCombo: {
		Tooltip: 右键攻击：基础冲刺-造成3倍伤害，并将玩家移动到光标所在位置
		DisplayName: 基础连段
	}

	KaiokenComboItem: {
		DisplayName: 界王拳
		Tooltip: 右键攻击：界王拳冲刺-造成3倍伤害，并将玩家移动到光标所在位置
	}

	StarFallItem: {
		DisplayName: 星之拳
		Tooltip: 右键技能：星辰反击-使用期间被击中时，召唤6颗从天而降的星辰，造成60点伤害
	}

	RadiantGauntletItem: {
		DisplayName: 辐辉拳套
		Tooltip: 右键攻击：辐辉冲锋-造成4倍伤害，并将玩家移动到光标所在位置
	}

	MechGauntletItem: {
		DisplayName: 机械拳套
		Tooltip:
			'''
			右键攻击：机械重拳-造成2倍伤害
			红色拳套会召唤激光束并向随机方向射出
			绿色拳套会用诅咒焰点燃敌人
			'''
	}

	ThunderFist: {
		DisplayName: 雷拳
		Tooltip: 右键攻击：闪电投掷-投射数道闪电，造成两倍伤害
	}

	BlazingGauntlet: {
		DisplayName: 炽焰拳套
		Tooltip: 右键技能：火焰护盾-火焰护盾会反弹只对你造成最大生命值30%或以下伤害的弹幕
	}

	StardustFall: {
		DisplayName: 星尘陨落
		Tooltip: ""
	}

	BurningAttack: {
		DisplayName: 燃烧攻击
		Tooltip: ""
	}

	GodSoul: {
		DisplayName: 神之魂晶
		Tooltip: "[C/959595:译者补充：请将《龙珠汉化全集》配置选项中修复打开，才能补充其配方]"
	}

	PolterghastSoul: {
		DisplayName: 噬魂幽花魂晶
		Tooltip: "[C/959595:译者补充：请将《龙珠汉化全集》配置选项中修复打开，才能补充其配方]"
	}

	WitchSoul: {
		DisplayName: 至尊女巫魂晶
		Tooltip: "[C/959595:译者补充：请将《龙珠汉化全集》配置选项中修复打开，才能补充其配方]"
	}

	GokuSenzuBean: {
		DisplayName: 悟空的仙豆
		Tooltip: "[C/959595:译者补充：击败硫海遗爵、亵渎天神和犽戎掉落，有且只掉落一次]"
	}

	DragonGauntlet: {
		DisplayName: 龙拳
		Tooltip: 右键攻击：龙拳-召唤一条巨龙追击敌怪
	}

	StatEditorItem: {
		DisplayName: 自定义气武器
		Tooltip:
			'''
			持有武器右键点击打开UI
			你可以使用点数提升武器属性
			你可以通过击败Boss和完成事件获得点数
			左键点击图标增加点数，右键点击图标移除点数
			你也可以按住Shift再任意点击，一次移除/增加10点
			要离开UI，点击右上角的离开图标
			要应用更改，点击离开图标的下方图标
			将此物品保持在快捷栏中选中，即可保持UI打开
			[C/959595:译者补充：该武器十分复杂，左上属性从左到右分别为：攻击、攻击速度、暴击率、弹幕速度]
			[C/959595:左下从左到右分别为：武器弹幕AI、武器弹幕额外属性]
			[C/959595:武器弹幕AI：]
			[C/959595:普通气弹]
			[C/959595:追踪 （击败世纪之花）]
			[C/959595:多发 （击败史莱姆皇后）]
			[C/959595:元气斩 （击败骷髅王）]
			[C/959595:环绕 （击败克苏鲁之眼）]
			[C/959595:反折 （击败蜂王）]
			[C/959595:二段追踪 （击败任意机械Boss）]
			[C/959595:武器弹幕额外属性：]
			[C/959595:无]
			[C/959595:生命窃取 （击败任意机械Boss）]
			[C/959595:爆炸 （击败史莱姆皇后）]
			[C/959595:防御增益 （击败独眼巨鹿）]
			[C/959595:反弹 （击败世界吞噬者或克苏鲁之脑）]
			[C/959595:穿墙 （击败骷髅王）]
			'''
	}

	LegendaryFist: {
		DisplayName: 传说之拳
		Tooltip: 右键攻击：传说粉碎-抓住附近的一名敌怪并对其造成5次伤害
