				// OldString: BetterDBT/NewContent/SoulBondingAmulet
				// NewString: BetterDBT/NewContent/SoulBondingAmulet
			}

			5: {
				// OldString: To obtain fusion, you'll need to kill all mech bosses,
				NewString: 获取融合功能，你想需要击败所有机械Boss
			}

			6: {
				// OldString: and then wait for 5 minutes for the items to spawn near the player.
				NewString: 然后等待5分钟，伪融合项链就会在玩家附近生成
			}

			7: {
