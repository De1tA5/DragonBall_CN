}

Items: {
	TerrarianAwakeningFruit: {
		DisplayName: 神秘之果
		Tooltip:
			'''
			一个不产自这个世界的奇特果实……
			[C/959595:译者补充：使用后会获得泰拉人基因，导致锁定大部分变身]
			[C/959595:如果你超级赛亚人达到100%掌握度可能会导致刷屏]
			'''
	}

	TestTerrarianTransform: {
		DisplayName: Test Terrarian Transform
		Tooltip: Test item 1, it may not work or maybe it will.
	}

	ForgottenKeepsake: {
		DisplayName: 遗忘信物
		Tooltip:
			'''
			来自远古之民的信物
			[C/959595:译者补充：使用后会获得虚弱，导致锁定大部分变身]
			[C/959595:如果你超级赛亚人达到100%掌握度可能会导致刷屏]
			'''
	}

	TerrarianTraitRemover: {
		DisplayName: 泰拉人资质移除器
		Tooltip:
			'''
			请谨慎使用，因为它不会移除所有东西……
			[C/959595:译者补充：移除本模组玩家的泰拉人基因、技法和使用道具，包括玩家的资质也会清空]
			'''
	}

	FirstTerrariansBook: {
		DisplayName: 尘封日志
		Tooltip:
			'''
			一份来自近乎被遗忘时代的残破记录
			[C/959595:译者补充：从空岛的天域箱中获取，整个世界只有1本]
			'''
	}

	BeginnersCombatManual: {
		DisplayName: 初级战斗手册
		Tooltip:
			''' 
			教授你基础的闪避与攻击
			[C/959595:译者补充：使用后解锁战斗艺术界面]
			[C/959595:地表木箱中获取，整个世界只有1本]
			'''
	}

	TerrarianProgressTester: {
		DisplayName: 泰拉人变身进度测试
		Tooltip: 改变进度
	}

	TempestFangManual: {
		DisplayName: 风暴獠牙手册
		Tooltip:
			''' 
			触摸它的感觉很怪，仿佛在触碰一个等离子球……
			[C/959595:译者补充：沙漠地下的沙岩箱中获取，整个世界只有2本]
			'''
	}

	TempestFangTester: {
		DisplayName: Tempest Fang Tester
		Tooltip: Does it really test out Tempest Fang???
	}

	AuricFlameManual: {
		DisplayName: 金源辉焰手册
		Tooltip:
			'''
			忠诚巨龙所留下的最后的礼物……
			[C/959595:译者补充：丛林地下迷你建筑的金箱中获取]
			[C/959595:且必须完成金源灌注形态最后一个任务，才能使用学会金源辉焰]
			'''
	}

	EternityBreakerManual: {
		DisplayName: Eternity Breaker Manual
		Tooltip: An item that doesnt exist...
	}

	TideKingsEdictManual: {
		DisplayName: Tide King's Edict Manual
		Tooltip: Some where in another Dimension maybe...
	}

	ZenkaiCrystal: {
		DisplayName: 全开水晶
		Tooltip:
			''' 
			一颗充满泰拉人希望的水晶……
			[C/959595:译者补充：暂时无法获取]
			[C/959595:只有你的全开值能被4整除时才能使用]
			'''
	}

	ZenkaiGem: {
		DisplayName: 全开宝石
		Tooltip:
			''' 
			一颗能吸引出色伙伴的宝石
			[C/959595:译者补充：暂时无法获取]
			[C/959595:只有你的全开值能被4整除时才能使用]
			'''
	}

	FlamezKhanScroll: {
		DisplayName: 神秘卷轴
		Tooltip:
			''' 
			只有极少数人知晓的技法，卷轴尚有余温……
			[C/959595:译者补充：挖掘灰烬块有0.02%概率掉落]
			[C/959595:使用后学会烈焰吐息]
			'''
	}

	VortexPrototype: {
		DisplayName: Vortex Prototype
		Tooltip: The Cosmic Engineer would Hate this...(FR FR 100 200%!!!)
	}

	VortexScrolls: {
		DisplayName: Vortex Heart
		Tooltip: The embodiment of Storms
	}

	FlameMeter: {
		DisplayName: 火焰测量仪
		Tooltip:
			''' 
			让金源辉焰持续5秒
			[C/959595:译者补充：实际上是显示金源辉焰DPS，但疑似bug无法正确显示]
			'''
	}

	FlameHeart: {
		DisplayName: 炎之心
		Tooltip:
			''' 
			完全由火焰构成的生命的心脏
			[C/959595:译者补充：由《灾厄》吞食魔掉落]
			[C/959595:使用后当前 金源辉焰 XP x3 ， 烈焰吐息 XP x4.5]
			'''
		
	}

	ZenkaiHuntTester: {
		DisplayName: 全开狩猎测试
		Tooltip:
			'''
			全开值设置为1000
			[C/959595:译者补充：除此之外还会开启全开狩猎系统]
			'''
	}

	TechniqueTransformationManual: {
		DisplayName: 技法手册
		Tooltip:
			''' 
			教授你如何正确使用技法
			[C/959595:译者补充：旅商有10%概率售卖]
			[C/959595:使用后，你的技巧会根据泰拉人变身形态额外获得伤害倍率加成]
			'''
	}

	WhiteGloves: {
		DisplayName: 白色手套
		Tooltip: ""
	}

	VortexScrollsTester: {
		DisplayName: Vortex Scrolls Tester
		Tooltip: ""
	}
}

Buffs: {
	TerrarianGeneBuff: {
		DisplayName: 泰拉人基因
		Description: 泰拉瑞亚的力量已召唤你走上一条古老的道路
	}

	TerrarianZenkaiCooldownBuff: {
		DisplayName: Season of Restoration
		Description: Even the strongest body must recover after hardship.
	}

	TerrarianInCombatBuff: {
		DisplayName: Trial of Battle
		Description: Conflict reveals what lies hidden within the heart.
	}

	TerrarianZenkaiBuff: {
		DisplayName: Terrarian Zenkai
		Description: Hardship endured becomes strength remembered.
	}

	AwakenedBuff: {
		DisplayName: 觉醒
		Description: Anger has awakened a hidden power, but it seeks to master you.
	}

	ResolvedWillBuff: {
		DisplayName: 决意
		Description: A heart without self-control leaves the soul open to darkness.
	}

	ReinforcedSoulBuff: {
		DisplayName: 锻魄
		Description: Through hardship, battle, and reflection, the soul is tempered.
	}

	TrueAwakeningBuff: {
		DisplayName: 真·觉醒
		Description: A Terrarian exists not for glory, but to guard the worlds entrusted to them.
	}

	AuricInfusedBuff: {
		DisplayName: 金源灌注
		Description: Yharon surrendered the endless flame, that another might stand against tyranny.
	}

	ApexOfEternityBuff: {
		DisplayName: 永恒之巅
		Description: The highest calling of a Terrarian is not to possess creation, but to faithfully guard it.
	}

	ForgottenKeepsake: {
		DisplayName: Forgotten Keepsake
		Tooltip: It's truly a miracle that you've survived this far.
	}

	WeakTraitBuff: {
		DisplayName: 虚弱
		Description: Your body is fragile, but something still refuses to let you disappear.
	}

	WeakTrialBuff: {
		DisplayName: The Rejected
		Description: Death looked upon you with pity and passed by.\nEndure, and mercy may yet find you.
	}

	TechniqueCooldownBuff: {
		DisplayName: 技法冷却
		Description: 你的技法正在恢复
	}

	FocusBuff: {
		DisplayName: 集中
		Description:
			'''
			增加10%伤害和防御
			精通时：翻倍加成，并提升40%移动速度和25%闪避率
			'''
	}

	OverdriveBuff: {
		DisplayName: 过载
		Description: 增加20%伤害和防御
	}
}

