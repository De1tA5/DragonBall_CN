UI: {
	FirstTerrariansBookUI: {
		OnInitialize: {
			1: {
				/* OldString:
					'''
					Forgotten by the world and weak as they were,
					still they endured.

					No Soul spoke their names.

					No kingdom chose them.

					Yet each time they were cast aside,
					they rose once more.

					The oldest fragment ends there.

					"...and though all things had abandoned them..."

					"...someone had not."
					''' */
				NewString:
					'''
					被世界遗忘，且如此弱小，
					但他们却依然坚持。

					没有灵魂能说出出他们的名字。
					没有王国选择他们。

					然而每一次被抛弃，
					他们都再度站起。

					最古老的残篇到此为止。

					“……尽管万物都已抛弃了他们……”

					“……有人没有。”
					'''
			}
		}
	}

