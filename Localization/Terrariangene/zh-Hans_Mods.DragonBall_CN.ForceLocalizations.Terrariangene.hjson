				2: {
					// OldString: Test ready: in Awakened, survive below 15% HP for 30s during a boss.
					NewString: 测试准备就绪： 处于觉醒形态，在Boss战中生命值低于15%并存活30秒
				}

				3: {
					// OldString: Test ready: in Resolved Will, survive below 10% HP for 60s during a boss.
					NewString: 测试准备就绪： 处于决意形态，在Boss战中生命值低于10%并存活60秒
				}

				4: {
					// OldString: Test ready: use Focus or Overdrive, then defeat one boss.
					NewString: 测试准备就绪： 处于集中或过载形态，并击败拜月邪教徒
				}

				5: {
					// OldString: Test ready: obtain Yharon's Soul, then press Breakthrough.
					NewString: 测试准备就绪： 获得巨龙金源魄，并按下 [突破] 键
				}

				6: {
					// OldString: Test ready: equip Soul of Eternity, then press Breakthrough.
					NewString: 测试准备就绪： 装备永恒之魂，并按下 [突破] 键
				}

				7: {
					// OldString: All Terrarian forms are already unlocked.
					NewString: 所有泰拉人形态已全部解锁
				}
			}
		}
	}
}

