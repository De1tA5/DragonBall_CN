DBZmodfargosNPC: {
	OnKill: {
		1: {
			// OldString: A dormant power erupts from the deep ocean.
			NewString: 一股沉睡的力量从深海中爆发
		}

		2: {
			// OldString: The sky shines bright with cosmic power.
			NewString: 天空闪耀着宇宙之力
		}

		3: {
			// OldString: A strange Ki can be felt radiating from the shimmering lake deep underground.
			NewString: 一股奇特的气，从地下深处的微观湖中散发出来
		}
	}
}

