	SaiyanBattleEnchantment: {
		DisplayName: Saiyan Battle Enchantment
		Tooltip:
			'''
			Increases your max Ki by 1000
			Increased Ki orb pickup range
			Increased Ki regen
			15% increased Ki damage
			8% reduced Ki Usage
			Effects of Pure Energy Circlet and Bloodstained Bandana
			'I will show you the power of a Saiyan Elite!'
			'''
	}

	TurtleHermitEnchantment: {
		DisplayName: Turtle Hermit Enchantment
		Tooltip:
			'''
			Increases your max Ki by 500
			Increased Ki charge speed
			Increased Ki regen
			15% reduced Ki usage
			+2 Maximum Charges
			Effects of Senzu Bean Bag
			'Maybe even a lower class outcast can surpass an elite if he puts his mind to it!'
			'''
	}

	SaiyanScoutEnchantment: {
		DisplayName: Saiyan Scout Enchantment
		Tooltip:
			'''
			Increases your max Ki by 500
			Increased Ki charge speed
			Increased Ki regen
			Increased Flight speed
			Reduced Flight Ki usage
			10% reduced Ki usage
			10% increased Ki damage
			15% increased Ki cast speed
			+1 Maximum Charge
			Effects of Battle Kit and Earthen Arcanium
			'Feel your Saiyan blood stir!!'
			'''
	}

	DemonEnchantment: {
		DisplayName: Demon Enchantment
		Tooltip:
			'''
			Press the Armor Bonus key to gain infinite Ki for a short time
			Increases your max Ki by 1500
			+1 Maximum Charge
			Effects of Spirit Charm and Dragon Ki Infuser
			'I am neither Kami nor Piccolo.'
			'''
	}

	BlackFusionEnchantment: {
		DisplayName: Black Fusion Enchantment
		Tooltip:
			'''
			All damage is slowly increased while a boss is alive, up to 300%
			Increases your max Ki by 1500
			+100 max Life
			+2 Maximum Charges
			Effects of Time Ring and Buldarium Sigmite
			'Mortals truly are pathetic.'
			'''
	}

	EliteSaiyanEnchantment: {
		DisplayName: Elite Saiyan Enchantment
		Tooltip:
			'''
			Taking fatal damage will instead restore you to max life with 2x damage for a short time
			1 minute cooldown
			Increased your max Ki by 2000
			30% reduced Ki usage
			+150 max Life
			+3 Maximum Charges
			Effects of Metamoran Sash
			'Yet in that brief time span, we Saiyan warriors have shattered our limits - time after time.'
			'''
	}

	RadiantEnchantment: {
		DisplayName: Radiant Enchantment
		Tooltip:
			'''
			Hitting enemies heals a random amount of Ki and fires off homing projectiles at nearby enemies
			Increases your max Ki by 5000
			Massively increased Ki regen
			Massively increased Life regen
			Increased speed while charging
			20% increased Ki damage
			+200 max Life
			+4 Maximum Charges
			'My power is rising... It's overflowing!'
			'''
	}

	SuperSaiyanEssence: {
		DisplayName: Super Saiyan Essence
		Tooltip:
			'''
			18% increased Ki damage
			8% increased Ki critical strike chance
			Increases your max Ki by 1000
			'This is only the beginning...'
			'''
	}

	SaiyanSoul: {
