	SaiyanBattleEnchantment: {
		DisplayName: 战斗赛亚人魔石
		Tooltip:
			'''
			增加1000点最大气值
			增加气珠拾取范围
			提升气回复速度
			增加15%气伤害
			减少8%气消耗
			获得纯粹能量圆环和血染头巾的效果
			“我会让你见识赛亚人精英的力量！”
			'''
	}

	TurtleHermitEnchantment: {
		DisplayName: 龟仙人魔石
		Tooltip:
			'''
			增加500点最大气值
			提升集气速度
			提升气回复速度
			减少15%气消耗
			提升2点武器最大蓄力段数
			获得仙豆袋的效果
			“也许就算是下等战士的弃子，只要下定决心，也能超越精英！”
			'''
	}

	SaiyanScoutEnchantment: {
		DisplayName: 侦察赛亚人魔石
		Tooltip:
			'''
			增加500点最大气值
			提升集气速度
			提升气回复速度
			提升飞行速度
			减少飞行时气消耗
			减少10%气消耗
			增加10%气伤害
			提升15%气攻击速度
			提升1点武器最大蓄力段数
			获得战斗套件和大地秘核的效果
			“感受你沸腾的赛亚人血脉吧！！”
			'''
	}

	DemonEnchantment: {
		DisplayName: 恶魔魔石
		Tooltip:
			'''
			按下 [套装奖励] 键使你获得恶魔超载，在此期间拥有无限气
			增加1500点最大气值
			提升1点武器最大蓄力段数
			获得灵魂护符和龙晶灌注器的效果
			“我既不是神仙，也不是比克”
			'''
	}

	BlackFusionEnchantment: {
		DisplayName: 黑色融合魔石
		Tooltip:
			'''
			在Boss存活时全职业伤害会缓慢提升，最高提升300%
			增加1500点最大气值
			增加100点最大生命值
			提升2点武器最大蓄力段数
			获得时之戒和巴德尔结晶的效果
			“凡人真是可悲”
			'''
	}

	EliteSaiyanEnchantment: {
		DisplayName: 精英赛亚人魔石
		Tooltip:
			'''
			受到致命伤害会立刻回满全部生命值并在一段时间内造成2倍伤害
			有1分钟冷却时间
			增加2000点最大气值
			减少30%气消耗
			增加150点最大生命值
			提升3点武器最大蓄力段数
			获得梅塔摩尔腰带的效果
			“可就在那短短的时间里，我们赛亚人战士一次又一次突破了自身的极限”
			'''
	}

	RadiantEnchantment: {
		DisplayName: 辐辉魔石
		Tooltip:
			'''
			击中敌怪会回复随机量的气，并向附近敌人发射追踪弹幕
			增加5000点最大气值
			大幅提升气回复速度
			大幅提升生命再生速度
			提升集气时的移动速度
			增加20%气伤害
			增加200点最大生命值
			提升4点武器最大蓄力段数
			“我的力量正不断提升……快压制不住了！”
			'''
	}

