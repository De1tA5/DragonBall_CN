	DACPlayer: {
		PostUpdate: {
			1: {
				OldString: You have shown again that you have exceptional abilities.
				NewString: You have shown again that you have exceptional abilities.
			}

			2: {
				OldString: Is this the height of this transformation?
				NewString: Is this the height of this transformation?
