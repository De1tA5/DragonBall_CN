Configs: {
	DBCPatchConfig: {
		DisplayName: 汉化补丁额外配置

		Headers: {
			ExtraPatches: 额外修复
			SpecialContent: 夹带私货
		}

		HideDBTBalanceTransformationTree: {
			Label: 移除《Dragon Ball Terraria: Rebalanced: Revived》的传说超赛4
			Tooltip:
				'''
				启用该选项，会禁用《Dragon Ball Terraria: Rebalanced: Revived》传说超级赛亚人4
				由于《Dragon Ball Terraria: Rebalanced: Revived》和《Oozaru》包含传说超级赛亚人4
				导致前者会把后者的传说超级赛亚人4覆盖，而后者还有更进一步强化形态
				请根据你游玩需要启用该修复
				[C/FF3E00:默认禁用，切换该选项需重新加载]
				'''
		}

		DBZMODPORTMapEntryFix: {
			Label: 龙珠本体制作站
			Tooltip:
				'''
				启用该选项，修复龙珠本体的使用合成表mod时，龙珠Z桌和龙珠改桌乱码问题
				由于本体模组未注册2个物块MapEntry，导致合成表mod会出现长串代码
				[C/FF3E00:默认启用，切换该选项需重新加载]
				'''
		}

		SSJ5FurRecipeFix: {
			Label: 修复《Oozaru》超级赛亚人5毛发配方
			Tooltip:
				'''
				启用该选项，会重新添加超级赛亚人5毛发的配方
				原配方其实已经写好但没有注册
				[C/FF3E00:默认启用，切换该选项需重新加载]
				'''
		}

		GokuItemsRecipeFix: {
			Label: 修复《Dragon Ball Terraria: Better Projectile Visuals》悟空物品配方
			Tooltip:
				'''
				启用该选项，修复模组部分无法合成的悟空强化物品的配方
				由于dbzcalamity不再更新，因此需要换成dbzcalamityUTD的物品才能合成
				[C/FF3E00:默认启用，切换该选项需重新加载]
				'''
		}

		AutoTransformation: {
			Label: 自动变身
			Tooltip:
				'''
				额外内容，允许玩家变身时一键获得所有可叠加形态
				[C/FF3E00:默认禁用]
				'''
		}

		HideSSJ8Transformation: {
			Label: 移除《Dragon Ball Terraria: AF & Calamity Addon》的超级赛亚人8
			Tooltip:
				'''
				启用该选项，会禁用《Dragon Ball Terraria: AF & Calamity Addon》的超级赛亚人8增益
				由于《Dragon Ball Terraria: AF & Calamity Addon》和《Kirby7's DBTR Custom Forms》的超级赛亚人8内部名称相同
				导致前者会把后者的超级赛亚人8覆盖，而且由于2个附属均为完整的变身树，无法单独禁用一个变身
				因此，该修复只能折中将前者禁用，请根据你游玩需要启用
				[C/FF3E00:默认禁用，切换该选项需重新加载]
				'''
		}
	}

	SubConfig: {
		Tooltip: ""

		enableFullPowerBuff: {
			Label: 全功率
			Tooltip: ""
		}

		enableShatteredLimitsBuff: {
			Label: 突破极限
			Tooltip: ""
		}

		enableUIBuff: {
			Label: 自在极意兆
			Tooltip: ""
		}

		enableVVSBuff: {
			Label: 紫色面纱
			Tooltip: ""
		}
	}
}
