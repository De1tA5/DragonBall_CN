Configs: {
	DBCPatchConfig: {
		DisplayName: 汉化补丁额外配置

		Headers: {
			ExtraPatches: 额外修复
			SpecialContent: 夹带私货
		}

		HideDBTBalanceTransformationTree: {
			Label: 移除《Dragon Ball Terraria: Rebalanced: Revived》的传说超赛4
			Tooltip:
				'''
				启用该选项，会禁用《Dragon Ball Terraria: Rebalanced: Revived》传说超级赛亚人4
				该bug由于《Dragon Ball Terraria: Rebalanced: Revived》和《Oozaru》包含传说超级赛亚人4
				导致前者会把后者的传说超级赛亚人4的变身buff以及变身面选取框给覆盖
				从而完全无法获得《Oozaru》的传说超级赛亚人4
				[C/FF3E00:默认禁用，切换该选项需重新加载]
				'''
		}

		DBZMODPORTMapEntryFix: {
			Label: 龙珠本体制作站
			Tooltip:
				'''
				启用该选项，修复龙珠本体的使用合成表mod时，龙珠Z桌和龙珠改桌乱码问题
				该bug由于本体模组未注册2个物块MapEntry，导致合成表mod会出现长串代码
				[C/FF3E00:默认启用，切换该选项需重新加载]
				'''
		}

		SSJ5FurRecipeFix: {
			Label: 修复《Oozaru》超级赛亚人5毛发配方
			Tooltip:
				'''
				启用该选项，会重新添加超级赛亚人5毛发的配方
				该bug由于原配方其实已经写好但没有注册
				[C/FF3E00:默认启用，切换该选项需重新加载]
				'''
		}

		GokuItemsRecipeFix: {
			Label: 修复《Dragon Ball Terraria: Better Projectile Visuals》悟空物品配方
			Tooltip:
				'''
				启用该选项，修复模组部分无法合成的悟空强化物品的配方
				该bug由于原模组依赖dbzcalamity而非最新dbzcalamityUTD
				而前者已不再适配最新灾厄，因此需要换成dbzcalamityUTD的物品才能合成
				[C/FF3E00:默认启用，切换该选项需重新加载]
				'''
		}

		AutoTransformation: {
			Label: 自动变身
			Tooltip:
				'''
				额外内容，允许玩家变身时获得所有可叠加形态
				[C/FF3E00:默认禁用]
				'''
		}

		ConflictBuffKeyFix: {
			Label: 修复内部名重复的变身形态
			Tooltip:
				'''
				启用该选项，会修复内部名重复的变身形态（仅限处于不同独立面板的变身），包括
				《Dragon Ball Terraria: AF & Calamity Addon》和《Kirby7's DBTR Custom Forms》的超级赛亚人8
				《Dragon Ball Terraria: Blue Evolution Addon》和《XV2 Forms and More》的极限突破
				启用后会根据变身面板直接来决定正确的变身形态
				该bug由于前置库没有使用更为精准的Buff ID来查找对应变身Buff
				而是使用BuffKeyName，这导致重名变身只会使用加载最早的变身
				[C/FF3E00:默认禁用，切换该选项需重新加载]
				'''
		}

		DebugMode: {
			Label: Debug模式
			Tooltip:
				'''
				正常游玩不需要启用
				仅为汉化补丁开发者使用的DeBug模式
				[C/FF3E00:默认禁用]
				'''
		}

		EnablePTOForm: {
			Label: 启用攻克之力变身形态
			Tooltip:
				'''
				启用该选项，会提供汉化补丁加入的攻克之力
				获取难度大且效果极端超模，仅作为彩蛋加入
				[C/FF3E00:默认禁用，切换该选项需重新加载]
				'''
		}

		DBCalamitySetBonusFix: {
			Label: 修复《Dragon Ball Terraria: Calamity Addon reuploaded》套装奖励不生效
			Tooltip:
				'''
				启用该选项，修复部分套装的套装奖励无法生效的问题
				该bug由于原模组使用Mod.Call("SetSetBonus")获得对应套装奖励
				而该方法已被灾厄弃用，故套装奖励无法生效
				[C/FF3E00:默认禁用]
				'''
		}
	}

	SubConfig: {
		Tooltip: ""

		enableFullPowerBuff: {
			Label: 全功率
			Tooltip: 必须启用《Awakening Power》
		}

		enableShatteredLimitsBuff: {
			Label: 突破极限
			Tooltip: 必须启用《Awakening Power》
		}

		enableUIBuff: {
			Label: 自在极意兆
			Tooltip: 必须启用《Dragon Ball Terraria: Calamity Addon reuploaded》
		}

		enableVVSBuff: {
			Label: 紫色面纱
			Tooltip: 必须启用《Dragon Ball Terraria: AF & Calamity Addon》
		}

		enableStackableUltimate: {
			Label: 究极
			Tooltip: 必须启用《XV2 Forms and More》
		}

		enablePTOBuff: {
			Label: 攻克之力
			Tooltip: 启用攻克之力变身
		}
	}
}

Buffs: {
	PTOBuff: {
		DisplayName: 攻克之力
		Description: 世界的力量充斥你全身
		MasterDescription: 你与世界融合为一
	}
}
